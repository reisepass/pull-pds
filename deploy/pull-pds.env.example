# Generate a private signing-key env file with: npm run keygen
# Set the endpoint to the exact externally served HTTPS origin, without a slash.
SELF_ENDPOINT=https://pds.example.com
DATA_DIR=/var/lib/pull-pds
HOST=127.0.0.1
PORT=3000
KEY_MODE=shared
INGEST_MODE=snapshot
# Collections publishers may write. app.bsky.*, chat.bsky.*, com.atproto.* and
# tools.ozone.* are always refused. Add a lexicon under lexicons/ for schema checks.
ALLOWED_COLLECTIONS=com.example.sensor.reading
MIN_PING_INTERVAL_SEC=60
# PDS_SIGNING_KEY is deliberately absent: generate a fresh key, never copy one.
